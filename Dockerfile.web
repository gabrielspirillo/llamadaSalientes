# syntax=docker/dockerfile:1.7
#
# Imagen de la app Next.js (web).
# Build context: raíz del repo. La construye GitHub Actions (.github/workflows/
# ci.yml) y la publica en GHCR; Dokploy ya no compila, sólo baja la imagen.
#
# Multi-stage para imagen final mínima (~150MB):
#   1. base    → node + pnpm
#   2. deps    → pnpm install --frozen-lockfile (cacheable layer)
#   3. builder → pnpm build (genera .next/standalone)
#   4. runner  → solo standalone + static + public, sin source ni dev deps

# ───────────────────────────────────────────────────────────────────────────
ARG NODE_VERSION=20-alpine

FROM node:${NODE_VERSION} AS base
RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /repo

# ───────────────────────────────────────────────────────────────────────────
FROM base AS deps
# Copiamos manifests del monorepo. El --mount=cache mantiene el store de pnpm
# entre builds, acelerando re-builds en Dokploy.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY packages/db-schema/package.json packages/db-schema/
COPY packages/shared-types/package.json packages/shared-types/
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# ───────────────────────────────────────────────────────────────────────────
FROM base AS builder
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps /repo/packages ./packages
COPY . .

# El build de Next embebe en el bundle todas las vars `NEXT_PUBLIC_*`, así que
# esas SÍ van como build-arg: son públicas por definición (acaban en el JS que
# descarga el navegador).
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
ARG NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=${NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY}
ENV NEXT_PUBLIC_CLERK_SIGN_IN_URL=${NEXT_PUBLIC_CLERK_SIGN_IN_URL}
ENV NEXT_PUBLIC_CLERK_SIGN_UP_URL=${NEXT_PUBLIC_CLERK_SIGN_UP_URL}

# Cuántos cores y cuánta heap puede usar el build. Los defaults son los del VPS
# (2 cores, 2,5 GB), donde el build compite con Postgres, Redis, MinIO y los dos
# contenedores de la app. En GitHub Actions la máquina está vacía y se suben.
ARG NEXT_BUILD_CPUS=2
ARG NODE_HEAP_MB=2560
ARG NEXT_BUILD_LOW_MEMORY=true
ENV NEXT_BUILD_CPUS=${NEXT_BUILD_CPUS}
ENV NEXT_BUILD_LOW_MEMORY=${NEXT_BUILD_LOW_MEMORY}

# Las vars PRIVADAS no van como ARG/ENV: quedarían para siempre en la config y
# en el historial de la imagen, y esta imagen se publica en un registro. Entran
# como secretos de BuildKit, que viven sólo durante este RUN y no dejan capa.
# `next build` no se conecta a nada con ellas: sólo tienen que satisfacer el
# esquema Zod de lib/env.ts, que valida el entorno al importarse.
#
# El caché de webpack (.next/cache) se monta como caché de BuildKit: sin esto
# cada build recompila los 643 ficheros desde cero. No entra en la imagen (el
# output standalone no lo necesita), sólo acelera el build siguiente.
RUN --mount=type=secret,id=DATABASE_URL \
    --mount=type=secret,id=DIRECT_URL \
    --mount=type=secret,id=CLERK_SECRET_KEY \
    --mount=type=secret,id=CLERK_WEBHOOK_SIGNING_SECRET \
    --mount=type=secret,id=ENCRYPTION_KEY \
    --mount=type=secret,id=SENTRY_DSN \
    --mount=type=cache,id=next-build-cache,target=/repo/apps/web/.next/cache \
    NODE_OPTIONS="--max-old-space-size=${NODE_HEAP_MB}" \
    DATABASE_URL="$(cat /run/secrets/DATABASE_URL)" \
    DIRECT_URL="$(cat /run/secrets/DIRECT_URL)" \
    CLERK_SECRET_KEY="$(cat /run/secrets/CLERK_SECRET_KEY)" \
    CLERK_WEBHOOK_SIGNING_SECRET="$(cat /run/secrets/CLERK_WEBHOOK_SIGNING_SECRET)" \
    ENCRYPTION_KEY="$(cat /run/secrets/ENCRYPTION_KEY)" \
    SENTRY_DSN="$(cat /run/secrets/SENTRY_DSN 2>/dev/null || true)" \
    pnpm --filter web build

# ───────────────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS runner
RUN apk add --no-cache libc6-compat tini ffmpeg
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Usuario no-root para defense in depth.
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001 -G nodejs

# Output standalone de Next: trae server.js + node_modules trazados, todo lo
# necesario para correr sin pnpm/yarn ni source.
COPY --from=builder --chown=nextjs:nodejs /repo/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /repo/apps/web/public ./apps/web/public

USER nextjs
EXPOSE 3000

# tini reapea zombies y propaga SIGTERM (graceful shutdown que Dokploy
# espera para redeploys sin downtime).
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/web/server.js"]
